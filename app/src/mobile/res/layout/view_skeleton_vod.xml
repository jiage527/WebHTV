<?xml version="1.0" encoding="utf-8"?>
<!--
  T2-25：首屏骨架屏。
  首屏期间原先只有 view_progress 的空转圈，用户看到的是「空白 + 转圈」。这里用与
  adapter_vod_rect 同尺寸、同圆角、同底色的占位卡片铺出内容形状，首帧一到即有
  「内容即将出现」的画面，而不是纯等待。

  复用真实卡片的既有资源（Vod.Grid 圆角 + shape_vod_name 名称条），因此骨架与内容
  同形，切换时不会跳变；刻意零新增 drawable。

  纯静态占位，不含动画：骨架只停留数百毫秒，进场动画反而增加首帧前的主线程与渲染
  负担，与本工单「缩短首帧时间」的目标相冲突。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp">

    <!-- 第一行：三张占位卡片，与 vod 网格的列宽一致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/black_20"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_vod_name" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/black_20"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_vod_name" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/black_20"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_vod_name" />

        </LinearLayout>

    </LinearLayout>

    <!-- 第二行：只铺两张，让形状更像真实内容的首两行而非规则色块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/black_20"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_vod_name" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/black_20"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_vod_name" />

        </LinearLayout>

        <!-- 第三列留空但占位，保持网格列宽与首行对齐 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
